# --- Core
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me

# --- Database (omit to fall back to SQLite)
DATABASE_URL=postgres://titan:titan@localhost:5432/titan
POSTGRES_DB=titan
POSTGRES_USER=titan
POSTGRES_PASSWORD=titan

# --- Frontend
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- SMS (ConsoleSMSBackend prints OTP codes to the server log)
SMS_BACKEND=apps.accounts.sms.ConsoleSMSBackend
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=titan-otp
# Testing only: every login code becomes this value (dev default 1234). Leave empty in production.
OTP_TEST_CODE=1234

# --- Payments: "zarinpal" or "fake" (fake auto-approves, dev only)
PAYMENT_GATEWAY=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=True
PAYMENT_CALLBACK_URL=http://localhost:8000/api/v1/payments/callback/

# --- Seeder
SEED_ADMIN_PASSWORD=admin
